  "batch_mix": [{"frac": 0.6, "offset": 0}, {"frac": 0.2, "offset": 150}, {"frac": 0.2, "offset": -150}],
  "milestone": {"min_games_at_or_above": 16},
  "demotion": {"min_games": 8},
  "rollback": {"p_worse": 0.9},
  "harness_limits": {"rules_chars": 1200, "lesson_chars": 220, "max_lessons": 8, "tool_tier_max": 2, "reason_words": 25, "seed_tools": ["legal_moves"]},
  "mine": {"nodes": 100000, "threads": 1, "nice": 10},
  "digest": {"max_tokens": 2500, "top_motifs": 3, "examples_per_motif": 2, "trend_gens": 2},
  "bank": {"min_loss": 10, "anchor_size": 120},
  "prescreen": {"positions": 16, "kill_p_below": 0.5, "max_unusable_rise": 0.05},
  "exam": {"looks": [40, 80, 120], "accept_p": [0.99, 0.97, 0.90], "futility_p": 0.30, "removal_min_gain": -0.5, "void_max": 0.10, "think_gain_per_1024": 1.0},
  "every_n_gens": {"shed": 4, "anchor_exam": 4},
  "final": {"slots_per_side": 24},
  "aa": {"real_positions": 40, "sim_false_accept_max": 0.05},
  "validity": {"exam_vs_game_loss_max_ratio": 2.0},
  "supervise": {"stall_s": 900, "backoff_s": [30, 120, 600], "retry_exit_code": 75},
  "doctor": {"require_ac": true, "min_free_gb": 5},
  "paths": {"heavy_lock": "~/.bonsai/heavy.lock", "server_lock": "~/helloworld/.heavy-lock", "runs": "runs/rsi", "replays": "tasks/chess/_replays"}
