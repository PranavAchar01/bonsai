  "workers": 3,
  "workers_when_server_busy": 2,
  "max_usd": 50,
  "max_hours": 10,
  "splits": {"train_families": 12, "held_families": 4, "openings": "rsi/openings.json"},
  "seed": "sha1(RUN_ID, gen, slot)[:10]",
  "games": {
    "per_gen": 24, "train": 16, "held": 8,
