{
  "note": "Frozen run config (prereg-lite). Copied to runs/rsi/<RUN_ID>/run.json and hashed into state.json at run start; any change means a new RUN_ID. null fields are filled once at run start (ladder_sha, proposer.resolved).",
  "cli": {"path": "/opt/homebrew/bin/claude", "version": "2.1.236"},
  "player": {"model": "claude-haiku-4-5-20251001", "alias": "haiku"},
  "proposer": {"model": "opus", "resolved": null, "timeout_s": 300, "attempts": 3, "children_per_gen": 2},
  "think_default": 0,
  "think_steps": [0, 1024, 2048],
  "call": {"timeout_base_s": 60, "timeout_s_per_think_token": 0.02, "attempts": 3, "backoff_s": [5, 20, 60], "usage_wait_max_s": 900},
  "stockfish": {"path": "/opt/homebrew/bin/stockfish", "version": "19", "threads": 1, "hash_mb": 16, "restarts": 2},
  "ladder_sha": null,
